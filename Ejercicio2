#include <stdio.h>

int main() {
    int vector[100];
    int n, i, suma = 0;
    float promedio;

    printf("Ingrese la cantidad de datos: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Ingrese el dato %d: ", i + 1);
        scanf("%d", &vector[i]);
    }

    printf("\nDatos del vector:\n");

    for (i = 0; i < n; i++) {
        printf("%d ", vector[i]);
        suma = suma + vector[i];
    }

    promedio = (float)suma / n;

    printf("\n\nSuma = %d", suma);
    printf("\nPromedio = %.2f\n", promedio);

    return 0;
}
