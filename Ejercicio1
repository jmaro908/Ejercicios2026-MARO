#include <stdio.h>

int main() {
    int vector[100];
    int n, i, posicion, nuevoDato;

    printf("Ingrese la cantidad de datos: ");
    scanf("%d", &n);


    for (i = 0; i < n; i++) {
        printf("Ingrese el dato %d: ", i + 1);
        scanf("%d", &vector[i]);
    }

    printf("\nIngrese la posicion que quiere modificar (1-%d): ", n);
    scanf("%d", &posicion);

    if (posicion >= 1 && posicion <= n) {
        printf("Ingrese el nuevo dato: ");
        scanf("%d", &nuevoDato);

        vector[posicion - 1] = nuevoDato;
    } else {
        printf("Posicion invalida.\n");
    }

    printf("\nDatos del vector:\n");

    for (i = 0; i < n; i++) {
        printf("Dato %d: %d\n", i + 1, vector[i]);
    }

    return 0;
}
